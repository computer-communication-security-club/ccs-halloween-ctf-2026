{
  "shelloween": {
    "challenge_integration_id": "shelloween",
    "instancer": "ccs",
    "config": {
      "services": {
        "chall": {
          "restart": "unless-stopped",
          "user": "node",
          "read_only": true,
          "tmpfs": {
            "/tmp": "size=16m,mode=1777"
          },
          "cap_drop": [
            "ALL"
          ],
          "security_opt": [
            "no-new-privileges:true"
          ],
          "cpus": 0.5,
          "mem_limit": "256m",
          "pids_limit": 128,
          "image": "sha256:0549701aa70a005a52a2a9ce756d700eadbe477fcc8dac20ce23a81b9eef89c2",
          "networks": [
            "internal"
          ],
          "dns": [
            "127.0.0.1"
          ]
        }
      },
      "networks": {
        "internal": {
          "driver": "bridge",
          "internal": true
        }
      }
    },
    "expose": [
      {
        "kind": "https",
        "host_prefix": "shelloween",
        "container_name": "chall",
        "container_port": 8000
      }
    ],
    "timeout_milliseconds": 1800000,
    "extendable": true
  },
  "poltergeist": {
    "challenge_integration_id": "poltergeist",
    "instancer": "ccs",
    "config": {
      "services": {
        "chall": {
          "restart": "unless-stopped",
          "environment": {
            "POW_BITS": "24",
            "GLIBC_TUNABLES": "glibc.cpu.x86_shstk=off"
          },
          "user": "10001:10001",
          "read_only": true,
          "tmpfs": {
            "/tmp": "size=16m,mode=1777"
          },
          "cap_drop": [
            "ALL"
          ],
          "security_opt": [
            "no-new-privileges:true"
          ],
          "cpus": 0.5,
          "mem_limit": "128m",
          "pids_limit": 64,
          "healthcheck": {
            "test": [
              "CMD",
              "bash",
              "-c",
              "exec 3<>/dev/tcp/127.0.0.1/8080; printf 'GET /healthz HTTP/1.0\\r\\n\\r\\n' >&3; grep -q ok <&3"
            ],
            "interval": "30s",
            "timeout": "5s",
            "retries": 3,
            "start_period": "5s"
          },
          "image": "sha256:310b9c0f3196b9cdde12396e07df337aa16854641a930004e4eef9a3740f4d91",
          "networks": [
            "internal"
          ],
          "dns": [
            "127.0.0.1"
          ]
        }
      },
      "networks": {
        "internal": {
          "driver": "bridge",
          "internal": true
        }
      }
    },
    "expose": [
      {
        "kind": "https",
        "host_prefix": "poltergeist",
        "container_name": "chall",
        "container_port": 8080
      }
    ],
    "timeout_milliseconds": 1800000,
    "extendable": true
  }
}
